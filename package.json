{
  "name": "snapkit",
  "version": "0.0.1",
  "description": "Developer-first, cross-platform screenshot & annotation tool with local auto-redaction of secrets.",
  "main": "./out/main/index.js",
  "author": "Snapkit <hello@snapkit.dev>",
  "homepage": "https://github.com/snapkit/snapkit",
  "license": "SEE LICENSE IN README.md",
  "scripts": {
    "predev": "node scripts/setup-ocr.mjs && node scripts/setup-bgr.mjs",
    "dev": "electron-vite dev",
    "prebuild": "node scripts/setup-ocr.mjs && node scripts/setup-bgr.mjs",
    "build": "electron-vite build",
    "package": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --publish never",
    "package:winmac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder -mw --publish never",
    "package:all": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder -mwl --publish never",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "gen:icon": "node scripts/make-tray-icon.mjs",
    "gen:appicon": "node scripts/make-app-icon.mjs"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "gifenc": "^1.0.3",
    "konva": "^10.3.0",
    "lucide-react": "^0.545.0",
    "react-konva": "^19.2.5",
    "tailwind-merge": "^3.3.1",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.9.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.1.12",
    "vitest": "^4.1.9"
  }
}
